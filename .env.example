# Development only. Bind to loopback; do not expose dev mode through a proxy.
DRAGONFRUIT_DEV_MODE=true
DRAGONFRUIT_STORAGE=postgres
DATABASE_URL=postgres://dragonfruit:dragonfruit@127.0.0.1:5432/dragonfruit
# Optional operator access (at least 32 characters); visit /operator. HTTP Basic user: operator
DRAGONFRUIT_ADMIN_TOKEN=
DRAGONFRUIT_PUBLIC_ORIGIN=http://localhost:5173
DRAGONFRUIT_WORKER_POLL_MS=1000

# Public account sign-in. Keep these values on the server.
# GitHub OAuth App callback: <DRAGONFRUIT_PUBLIC_ORIGIN>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Postmark transactional server token. Verify info@dragonfruit.studio or its domain first.
# Authentication emails always use From: info@dragonfruit.studio, stream: outbound.
POSTMARK_SERVER_TOKEN=

# Builder account billing (separate from Stripe credentials used by exported shops).
# Create USD one-time $9.99 and USD monthly $24.99 Prices in your Stripe account.
# Payments are disabled with memory storage; PostgreSQL + migration 004 are required.
DRAGONFRUIT_STRIPE_SECRET_KEY=
DRAGONFRUIT_STRIPE_WEBHOOK_SECRET=
DRAGONFRUIT_STRIPE_SLOT_PRICE_ID=
DRAGONFRUIT_STRIPE_UNLIMITED_PRICE_ID=
# Webhook endpoint: <DRAGONFRUIT_PUBLIC_ORIGIN>/api/billing/webhook
# Enable the Stripe Customer Portal with payment updates and subscription cancellation.
